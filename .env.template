# 管理画面認証JSON。AWSでParameter Storeを使う場合は空で構いません。
XSBOT_ADMIN_AUTH_JSON='{"users":{"admin":"your-argon2id-hash"},"session_secret":"replace-me"}'
XSBOT_API_TOKEN=your-api-token

# GCP設定
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number
GOOGLE_CLOUD_LOCATION=asia-northeast1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
XSBOT_STORAGE_BUCKET=your-storage-bucket
XSBOT_APP_BASE_URL=https://your-app-service-url
XSBOT_BUILDER_BASE_URL=https://your-builder-service-url

# AWS設定
# AWSで起動するときだけawsを指定します。未指定時は従来どおりGCPです。
XSBOT_CLOUD_PROVIDER=gcp
AWS_REGION=your-aws-region
XSBOT_AWS_RUNTIME_SECRETS_PARAMETER=/xstorybot/your-environment/runtime-secrets
XSBOT_AWS_SHEETS_CREDENTIAL_PARAMETER=/xstorybot/your-environment/google-sheets-service-account
XSBOT_AWS_ADMIN_AUTH_PARAMETER=/xstorybot/your-environment/admin-auth
XSBOT_AWS_PRIVATE_BUCKET=your-private-bucket
XSBOT_AWS_MEDIA_BUCKET=your-media-bucket
XSBOT_AWS_PUBLIC_MEDIA_BASE_URL=https://your-distribution.cloudfront.net
XSBOT_AWS_STATE_TABLE=your-state-table
XSBOT_AWS_GROUP_TASK_TABLE=your-group-task-table
XSBOT_AWS_GROUP_TASK_INDEX=your-group-task-index
XSBOT_AWS_CACHE_TABLE=your-cache-table
XSBOT_AWS_ACTION_QUEUE_URL=https://sqs.your-aws-region.amazonaws.com/000000000000/your-action-queue
XSBOT_AWS_ACTION_QUEUE_ARN=arn:aws:sqs:your-aws-region:000000000000:your-action-queue
XSBOT_AWS_GROUP_MESSAGE_QUEUE_URL=https://sqs.your-aws-region.amazonaws.com/000000000000/your-group-message-queue
XSBOT_AWS_GROUP_MESSAGE_QUEUE_ARN=arn:aws:sqs:your-aws-region:000000000000:your-group-message-queue
XSBOT_AWS_SCHEDULER_ROLE_ARN=arn:aws:iam::000000000000:role/your-scheduler-role
XSBOT_AWS_SCHEDULER_GROUP_NAME=your-scheduler-group
XSBOT_AWS_SCHEDULER_DLQ_ARN=arn:aws:sqs:your-aws-region:000000000000:your-dlq
XSBOT_AWS_BUILD_CLUSTER=your-ecs-cluster
XSBOT_AWS_BUILD_TASK_DEFINITION=your-ecs-task-definition
XSBOT_AWS_BUILD_CONTAINER_NAME=xstorybot
XSBOT_AWS_BUILD_SUBNET_ID_1=subnet-00000000000000001
XSBOT_AWS_BUILD_SUBNET_ID_2=subnet-00000000000000002
XSBOT_AWS_BUILD_SECURITY_GROUP_ID=sg-00000000000000000
# LINE設定
LINE_CHANNEL_ID=your-channel-id
LINE_CHANNEL_SECRET=your-channel-secret
LINE_ACCESS_TOKEN=your-access-token

# Google Sheets設定
SHEETS_ID=your-sheet-id
SHEETS_SERVICE_ACCOUNT=path/to/sheets-service-account.json

# OpenAI設定（オプショナル）
OPENAI_API_KEY=your-openai-api-key

# Twilio設定（オプショナル）
TWILIO_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-phone-number

# Pusher設定（オプショナル）
PUSHER_APP_ID=your-pusher-app-id
PUSHER_APP_KEY=your-pusher-key
PUSHER_APP_SECRET=your-pusher-secret
PUSHER_APP_CLUSTER=ap3

# このファイルを.env.test、.env.dev、.env.prodにコピーして、
# それぞれの環境用の値を設定してください。
